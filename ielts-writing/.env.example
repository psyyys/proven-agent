# 复制本文件为 .env，然后填写你的 API 信息（任何 OpenAI 兼容接口都可以）
# 也可以不建 .env，直接在网页右上角「设置」里填写

# 接口地址（以 /v1 之类的版本路径结尾，程序会自动拼接 /chat/completions）
#   DeepSeek:  https://api.deepseek.com/v1
#   Kimi:      https://api.moonshot.cn/v1
#   通义千问:   https://dashscope.aliyuncs.com/compatible-mode/v1
#   智谱 GLM:  https://open.bigmodel.cn/api/paas/v4
#   OpenAI:    https://api.openai.com/v1
API_BASE_URL=https://api.deepseek.com/v1

# 你的 API Key
API_KEY=

# 模型名，例如 deepseek-chat / moonshot-v1-32k / qwen-plus / glm-4-plus / gpt-4o-mini
MODEL=deepseek-chat

# 本地端口（可选）
PORT=3000
