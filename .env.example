# 模型服务（任何 OpenAI 兼容接口均可）
# 阿里云百炼（通义千问 / 也可调用 DeepSeek）
PROVEN_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
PROVEN_LLM_API_KEY=sk-...
PROVEN_LLM_MODEL=qwen-plus

# DeepSeek 官方：
# PROVEN_LLM_BASE_URL=https://api.deepseek.com
# PROVEN_LLM_MODEL=deepseek-chat

# RAG 向量模型（留空则只用 BM25 关键词检索）
PROVEN_EMBED_MODEL=text-embedding-v4
# 可选：单独的向量服务地址 / Key，留空则沿用上面的
# PROVEN_EMBED_BASE_URL=
# PROVEN_EMBED_API_KEY=

# 可选：重排模型（百炼 gte-rerank），留空则不重排
# PROVEN_RERANK_MODEL=gte-rerank-v2

# 运行参数
PROVEN_WORKSPACE=./workspace
PROVEN_MAX_STEPS=40
# 执行模式：single（单 Agent）或 multi（每个计划步骤派一个上下文独立的分析员）
PROVEN_MODE=single
# 多 Agent 模式下每个分析员最多调用工具的轮数
PROVEN_STEP_BUDGET=10
# 审核员：off（不审核）、rules（只做领域规则检查，不调用模型）、full（规则检查 + 模型审核）
PROVEN_REVIEW=full
# 经验（反思员）：off（不参考也不学习）、use（参考已有教训，不再学习）、learn（参考，并在每次运行后从失败中总结教训）
PROVEN_LESSONS=learn
PROVEN_CELL_TIMEOUT=120
PROVEN_DATA_DIR=./data
